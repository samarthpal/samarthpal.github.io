{
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "paths": {
      "api": ["src/api"],
      "api/*": ["src/api/*"],
      "assets/*": ["src/assets/*"],
      "components": ["src/components"],
      "components/*": ["src/components/*"],
      "data/*": ["src/data/*"],
      "helpers/*": ["src/helpers/*"],
      "hooks/*": ["src/hooks/*"],
      "images/*": ["src/images/*"],
      "layouts/*": ["src/layouts/*"],
      "pages": ["src/pages"],
      "pages/*": ["src/pages/*"],
      "styles/*": ["src/styles/*"]
    }
  },
  "include": ["src"]
}
